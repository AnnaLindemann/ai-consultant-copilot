# Client environment. Copy to `client/.env.local`:
#   cp client/.env.local.example client/.env.local

# Base URL of the backend API — an origin, with no trailing path.
#
# In development it defaults to http://localhost:8787 in code, so this only
# needs changing when the server runs elsewhere.
#
# In a PRODUCTION BUILD it is required, and the build refuses to complete
# without a valid https:// value. The reason is that NEXT_PUBLIC_* values are
# inlined into the JavaScript bundle at build time: a build that ran without it
# would ship a frontend that calls http://localhost:8787 from each visitor's own
# browser. Set it in the hosting project for every environment that is built,
# and remember that changing it needs a rebuild rather than a redeploy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
