# Root environment — consumed by docker-compose.yml to provision PostgreSQL.
# Copy this file to `.env` and adjust as needed:  cp .env.example .env

# PostgreSQL credentials for the local Docker container.
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_DB=ai_consultant_db

# Host port the Postgres container is published on (container always listens on 5432).
POSTGRES_PORT=5432

# Connection string used by tooling run from the repo root, if any.
# Must match the credentials and port above.
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5432/ai_consultant_db
