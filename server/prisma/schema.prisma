generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CompanySize {
  solo
  micro
  small
  medium
  large
  enterprise
}

enum Level {
  low
  medium
  high
}

enum ProcessFrequency {
  rarely
  monthly
  weekly
  daily
  many_times_per_day
}

enum DataAvailability {
  none
  unknown
  restricted
  available
}

enum DataQuality {
  poor
  mixed
  good
  unknown
}

enum Timeline {
  asap
  this_quarter
  this_year
  unknown
}

enum Currency {
  EUR
  USD
  GBP
  OTHER
}

// Where the Discovery Profile stands in its review workflow (Phase 2
// Extension; domain-model.md §3A.3). Submission is a review checkpoint, not a
// lock: discovery stays revisable in every state, and acceptance never ends the
// ability to revise it later.
enum DiscoveryStatus {
  draft
  submitted
  returned
  accepted
}

// Who acted on discovery. Until Phase 3A delivers authentication this is a
// declared role rather than an authenticated identity — it decides which
// workflow transitions the domain permits; it is not access control.
enum DiscoveryActor {
  consultant
  client
}

// Where the Assessment stands in the human-in-the-loop cycle (roadmap Phase 3).
// AI output is persisted as an unreviewed draft; once the consultant edits or
// accepts it, regenerating requires their explicit intent so their work is never
// silently overwritten (architecture.md §5; agent-rules.md §10).
enum AssessmentReviewState {
  ai_draft
  consultant_edited
  accepted
}

// Where an engagement currently stands in the consulting methodology
// (domain-model.md §3). Phase 1 only tracks the stage marker; later phases
// add the content each stage produces. `discovery` is the first stage, so a
// freshly-created (still empty) engagement starts there.
enum EngagementStage {
  discovery
  assessment
  prioritization
  solution_matching
  roadmap
  report
}

// The grouping of a client's engagements — identity and company-level context
// only, deliberately NOT a customer-relationship record (domain-model.md §2,
// §6; architecture.md §4.2). One Organization owns many Engagements and holds
// no methodology state itself.
model Organization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  industry    String?
  companySize CompanySize?
  geography   String?
  notes       String?

  engagements Engagement[]

  @@index([name])
  @@index([createdAt])
}

// The primary engagement-side aggregate and single source of truth for all
// client-specific state (domain-model.md §2 "Engagement"; architecture.md
// §4.2). Phase 1 establishes the foundation: it belongs to an Organization,
// tracks its methodology `stage`, and can be created empty, saved, and
// resumed. Later phases attach discovery/assessment/opportunities/etc. content
// to this same record rather than a parallel store (roadmap Phase 1).
//
// Company-level identity/context (name, industry, size, geography) lives on the
// Organization, not here. The physical table was renamed from the legacy
// `ClientCase` in Phase 1 (architecture.md §6), so no `@@map` remains.
model Engagement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A short label distinguishing engagements within one organization.
  title String?

  // Where the engagement currently stands (roadmap Phase 1).
  stage EngagementStage @default(discovery)

  analysisRuns AnalysisRun[]

  department String?

  // Discovery Profile. Stable facts use typed columns while evolving nested
  // lists use validated Json fields (architecture.md §6). Explicit gaps are
  // persisted alongside known facts so discovery can be resumed and revised.
  statedProblem  String?
  painPoints     Json?
  affectedUsers  Json?
  businessImpact String?
  urgency        Level?

  // Current process
  currentProcess   String?
  processSteps     Json?
  processFrequency ProcessFrequency?
  manualWorkLevel  Level?
  bottlenecks      Json?

  // Tools
  currentTools          Json?
  communicationChannels Json?
  integrationNeeds      Json?

  // Data
  dataTypes          Json?
  dataLocation       Json?
  dataAvailability   DataAvailability?
  dataQuality        DataQuality?
  sensitiveData      Boolean?
  sensitiveDataTypes Json?

  // Constraints
  gdprConcerns          Boolean?
  budgetAmount          Decimal?  @db.Decimal(12, 2)
  budgetCurrency        Currency?
  budgetNotes           String?
  timeline              Timeline?
  humanApprovalRequired Boolean?
  technicalConstraints  Json?

  // Goals
  desiredOutcome     String?
  successMetrics     Json?
  mvpScope           String?
  notes              String?
  missingInformation Json?

  // Value & measurement baseline (Phase 2 Extension). The metric structures are
  // still stabilizing, so the validated payload is stored as Json owned by the
  // Engagement aggregate, while the workflow's stable parts — status,
  // provenance, timestamps — are typed columns (architecture.md §6).
  valueMeasurementBaseline Json?

  // The Discovery review workflow: where the profile stands, who submitted it
  // and when, when the consultant reviewed it, the notes they returned it with,
  // and which section of the content came from whom. Provenance is a map of
  // section → consultant_captured | client_provided.
  discoveryStatus            DiscoveryStatus @default(draft)
  discoverySubmittedAt       DateTime?
  discoverySubmittedBy       DiscoveryActor?
  discoveryReviewedAt        DateTime?
  discoveryReturnNotes       String?
  discoveryContentProvenance Json?

  // Assessment (roadmap Phase 3). The findings of all dimensions are still
  // stabilizing, so the validated payload is stored as Json owned by the
  // Engagement aggregate rather than in a parallel store (architecture.md §6);
  // its review state is a stable, typed marker.
  assessment            Json?
  assessmentReviewState AssessmentReviewState?

  @@index([organizationId])
  @@index([stage])
  @@index([discoveryStatus])
  @@index([createdAt])
  @@index([sensitiveData])
  @@index([gdprConcerns])
}

model AnalysisRun {
  id String @id @default(cuid())

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  // Which methodology stage the run supported, so runs can be filtered by stage
  // while still rolling up to the engagement (architecture.md §8). Runs recorded
  // before the assessment stage existed carry the legacy `analysis` value.
  stage String

  provider String
  model    String

  promptVersion String?
  promptFingerprint String?
  latencyMs Int?

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  costEstimateUsd Decimal? @db.Decimal(10, 6)

  // Objective quality signals recorded on every run.
  jsonParseSuccess  Boolean
  schemaValid       Boolean

  // Subjective quality signals are reserved for a genuine evaluator and are
  // left unpopulated until one exists — no placeholder scores are written
  // (roadmap Phase 0; architecture.md §5; coding-standards.md §8 "No fake
  // quality signals").
  relevance         String?
  hallucinationRisk String?
  businessValue     String?
  actionability     String?

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([engagementId])
  @@index([provider, model])
  @@index([createdAt])
}
