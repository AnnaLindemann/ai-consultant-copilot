generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CompanySize {
  solo
  micro
  small
  medium
  large
  enterprise
}

enum Level {
  low
  medium
  high
}

enum ProcessFrequency {
  rarely
  monthly
  weekly
  daily
  many_times_per_day
}

enum DataAvailability {
  none
  unknown
  restricted
  available
}

enum DataQuality {
  poor
  mixed
  good
  unknown
}

enum Timeline {
  asap
  this_quarter
  this_year
  unknown
}

enum Currency {
  EUR
  USD
  GBP
  OTHER
}

enum UserRole {
  ADMIN
  MANAGER
  CLIENT
}

enum ConsultingKnowledgeKind {
  business_domain
  business_process
  business_problem
  customer_operations_taxonomy
  discovery_question
  assessment_framework
  ai_readiness_criterion
  ai_use_case
  solution_pattern
  implementation_pattern
  roi_model
  risk_model
  best_practice
  follow_up_template
}

// Whether a Technology Profile is current or has been retired (roadmap Phase
// 5A). A deprecated profile stays readable and stays citable by whatever
// already referenced it, but retrieval never selects it again.
enum TechnologyProfileStatus {
  active
  deprecated
}

// How a Technology Profile's current content came to be (roadmap Phase 5A).
// It is **origin metadata, not approval history**: `product_seed` is content
// the product shipped in its initial catalogue and that no human approved
// through the curator, so it has no Technology Update History entry;
// `curator` is content applied from an explicitly approved proposal, from
// which point the append-only history is the record.
enum TechnologyProfileOrigin {
  product_seed
  curator
}

// What a Technology Update Proposal does to the Technology Knowledge Base —
// the three changes the domain model names: "new, revised, or deprecated
// technology/model information" (domain-model.md §2).
enum TechnologyChangeKind {
  create
  revise
  deprecate
}

// Where a Technology Update Proposal stands. `pending` is the only state from
// which the knowledge base can still change; both decisions are terminal, so a
// decided proposal is never re-decided or re-applied (architecture.md §9.3).
enum TechnologyProposalStatus {
  pending
  approved
  rejected
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum DiscoveryAccessStatus {
  pending
  active
  revoked
  expired
}

// Where the Discovery Profile stands in its review workflow (Phase 2
// Extension; domain-model.md §3A.3). Submission is a review checkpoint, not a
// lock: discovery stays revisable in every state, and acceptance never ends the
// ability to revise it later.
enum DiscoveryStatus {
  draft
  submitted
  returned
  accepted
}

// Who acted on discovery. Until Phase 3A delivers authentication this is a
// declared role rather than an authenticated identity — it decides which
// workflow transitions the domain permits; it is not access control.
enum DiscoveryActor {
  consultant
  client
}

// Where the Assessment stands in the human-in-the-loop cycle (roadmap Phase 3).
// AI output is persisted as an unreviewed draft; once the consultant edits or
// accepts it, regenerating requires their explicit intent so their work is never
// silently overwritten (architecture.md §5; agent-rules.md §10).
enum AssessmentReviewState {
  ai_draft
  consultant_edited
  accepted
}

// Where the prioritized Opportunities stand in the human-in-the-loop cycle
// (roadmap Phase 4). It mirrors AssessmentReviewState deliberately: each stage
// carries its own review marker, so neither stage's stored contract moves when
// the other's does.
enum OpportunityReviewState {
  ai_draft
  consultant_edited
  accepted
}

// Whether an Opportunity version is the one being worked on or the preserved
// record of what was prioritized earlier (roadmap Phase 4). Regeneration
// supersedes rather than overwrites: no version is ever rewritten or deleted,
// mirroring append-only Consultant Report versions (architecture.md §4.3).
enum OpportunityVersionStatus {
  active
  superseded
}

// Where the grounded Recommendations stand in the human-in-the-loop cycle
// (roadmap Phase 6). It mirrors the two stages before it deliberately: each
// stage carries its own review marker, so neither stage's stored contract moves
// when another's does.
enum RecommendationReviewState {
  ai_draft
  consultant_edited
  accepted
}

// Whether a Recommendation version is the one being worked on or the preserved
// record of what was recommended earlier (roadmap Phase 6).
enum RecommendationVersionStatus {
  active
  superseded
}

enum RoadmapReviewState {
  ai_draft
  consultant_edited
  accepted
}

enum RoadmapVersionStatus {
  active
  superseded
}

enum ReportReviewState {
  draft
  manager_review
  approved
}

enum ReportVersionStatus {
  active
  superseded
}

enum DocumentPublicationStatus {
  active
  revoked
  superseded
}

enum DocumentNotificationOutcome {
  pending
  sent
  failed
}

enum ClientFeedbackStatus {
  submitted
  classified
  reentry_open
  resolved
  closed_no_action
}

enum ClientFeedbackClassification {
  new_fact
  fact_correction
  changed_condition
  disagreement
  clarification
  request
  duplicate
  no_engagement_change_required
}

enum FeedbackReentryStatus {
  open
  completed
}

// How sensitive a piece of engagement content, a document, or a generated
// output is (roadmap Phase 10 "Data Classification"). `personal_data` and
// `ai_restricted` are classifications in their own right rather than modifiers:
// personal data must be redacted/pseudonymized before it reaches a provider, and
// AI-restricted content never reaches one at all. Their relative protection
// order lives in `shared/compliance.schema.ts`, not in the database.
enum DataClassification {
  public
  internal
  confidential
  personal_data
  strictly_confidential
  ai_restricted
}

// The engagement's own **permission** for AI processing, asked in addition to
// the workspace policy and never instead of it. `restricted` means AI may
// assist, but only on non-confidential content and only after PII redaction.
//
// This is an internal permission, **not consent under GDPR Article 6(1)(a)**.
// What makes processing lawful is `Engagement.legalBasis` and, where that basis
// is consent, an `EngagementConsentRecord`.
enum AiProcessingPermission {
  allowed
  restricted
  prohibited
}

// The GDPR Article 6 legal basis an engagement's personal-data processing rests
// on. `not_assessed` is the honest starting value and the only one the product
// writes on its own — a legal basis is a human's determination.
enum LegalBasis {
  contract
  legitimate_interest
  legal_obligation
  consent
  not_assessed
}

// What was done about personal data before an AI request left for the provider.
//
// Deliberately **redaction**, not anonymization: recognized identifiers are
// replaced with stable placeholders, which is pseudonymization at best and is
// not irreversible. `failed` records a request that was refused because
// redaction could not be completed — the pipeline never falls back to sending
// the original text.
enum PiiRedactionStatus {
  not_required
  applied
  failed
}

// What the re-scan of the model's *response* found. An output is never assumed
// clean because the input was redacted (roadmap Phase 10 corrections §5).
enum AiOutputScanOutcome {
  not_scanned
  clean
  personal_data_detected
}

// Where the engagement stands against the workspace's standard DPIA/DSFA. The
// determination is a human's; `not_assessed` is what the product says until one
// has been made.
enum EngagementDpiaScreening {
  not_assessed
  within_standard_dpia
  additional_not_required
  additional_required
  additional_completed
}

// Where the workspace's DPIA/DSFA for the standard processing operation stands.
enum WorkspaceDpiaStatus {
  not_started
  in_progress
  approved
  not_required
}

// Where a workspace's approval of one provider/model stands. Deny-by-default:
// only `approved` permits an AI request. `needs_review` means an Administrator
// has to look at it again — either because it was carried over from a free-text
// list, or because an approved Technology Update changed a compliance-relevant
// fact beneath it.
enum AiModelApprovalStatus {
  approved
  needs_review
  revoked
}

// Whether a data-processing agreement covers this provider.
enum DpaStatus {
  in_place
  not_required
  pending
  not_assessed
}

// What the workspace decided about the provider retaining prompts and inputs.
enum PromptRetentionDecision {
  not_retained
  retained_limited
  retained_unknown
}

// What the workspace decided about the provider training on its inputs.
enum TrainingUseDecision {
  excluded
  permitted
  unknown
}

// Whether a human has reviewed what an AI-assisted step produced.
// `not_required` is recorded when the workspace policy does not demand approval
// before AI output becomes accepted engagement content.
enum HumanReviewStatus {
  not_required
  pending
  reviewed
}

// Where an engagement currently stands in the consulting methodology
// (domain-model.md §3). Phase 1 only tracks the stage marker; later phases
// add the content each stage produces. `discovery` is the first stage, so a
// freshly-created (still empty) engagement starts there.
enum EngagementStage {
  discovery
  assessment
  prioritization
  solution_matching
  roadmap
  report
}

// The grouping of a client's engagements — identity and company-level context
// only, deliberately NOT a customer-relationship record (domain-model.md §2,
// §6; architecture.md §4.2). One Organization owns many Engagements and holds
// no methodology state itself.
model Organization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  industry    String?
  companySize CompanySize?
  geography   String?
  notes       String?

  engagements Engagement[]

  @@index([workspaceId])
  @@index([name])
  @@index([createdAt])
}

// The primary engagement-side aggregate and single source of truth for all
// client-specific state (domain-model.md §2 "Engagement"; architecture.md
// §4.2). Phase 1 establishes the foundation: it belongs to an Organization,
// tracks its methodology `stage`, and can be created empty, saved, and
// resumed. Later phases attach discovery/assessment/opportunities/etc. content
// to this same record rather than a parallel store (roadmap Phase 1).
//
// Company-level identity/context (name, industry, size, geography) lives on the
// Organization, not here. The physical table was renamed from the legacy
// `ClientCase` in Phase 1 (architecture.md §6), so no `@@map` remains.
model Engagement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  owningManagerId String
  owningManager   User   @relation("EngagementOwnedBy", fields: [owningManagerId], references: [id], onDelete: Restrict)

  // A short label distinguishing engagements within one organization.
  title String?

  // Where the engagement currently stands (roadmap Phase 1).
  stage EngagementStage @default(discovery)

  analysisRuns AnalysisRun[]

  department String?

  // Discovery Profile. Stable facts use typed columns while evolving nested
  // lists use validated Json fields (architecture.md §6). Explicit gaps are
  // persisted alongside known facts so discovery can be resumed and revised.
  statedProblem  String?
  painPoints     Json?
  affectedUsers  Json?
  businessImpact String?
  urgency        Level?

  // Current process
  currentProcess   String?
  processSteps     Json?
  processFrequency ProcessFrequency?
  manualWorkLevel  Level?
  bottlenecks      Json?

  // Tools
  currentTools          Json?
  communicationChannels Json?
  integrationNeeds      Json?

  // Data
  dataTypes          Json?
  dataLocation       Json?
  dataAvailability   DataAvailability?
  dataQuality        DataQuality?
  sensitiveData      Boolean?
  sensitiveDataTypes Json?

  // Constraints
  gdprConcerns          Boolean?
  budgetAmount          Decimal?  @db.Decimal(12, 2)
  budgetCurrency        Currency?
  budgetNotes           String?
  timeline              Timeline?
  humanApprovalRequired Boolean?
  technicalConstraints  Json?

  // Goals
  desiredOutcome     String?
  successMetrics     Json?
  mvpScope           String?
  notes              String?
  missingInformation Json?

  // Value & measurement baseline (Phase 2 Extension). The metric structures are
  // still stabilizing, so the validated payload is stored as Json owned by the
  // Engagement aggregate, while the workflow's stable parts — status,
  // provenance, timestamps — are typed columns (architecture.md §6).
  valueMeasurementBaseline Json?

  // The Discovery review workflow: where the profile stands, who submitted it
  // and when, when the consultant reviewed it, the notes they returned it with,
  // and which section of the content came from whom. Provenance is a map of
  // section → consultant_captured | client_provided.
  discoveryStatus            DiscoveryStatus @default(draft)
  discoverySubmittedAt       DateTime?
  discoverySubmittedBy       DiscoveryActor?
  discoveryReviewedAt        DateTime?
  discoveryReturnNotes       String?
  discoveryContentProvenance Json?

  // Assessment (roadmap Phase 3). The findings of all dimensions are still
  // stabilizing, so the validated payload is stored as Json owned by the
  // Engagement aggregate rather than in a parallel store (architecture.md §6);
  // its review state is a stable, typed marker.
  assessment            Json?
  assessmentReviewState AssessmentReviewState?

  // How many times the Assessment has been written. It gives a reader a plain
  // number to refer to ("prioritized from Assessment revision 3"); whether a
  // derived stage has gone *stale* is decided by the content fingerprint the
  // derived stage recorded, not by this counter.
  assessmentRevision Int @default(0)

  // Prioritized Opportunities (roadmap Phase 4). Every generated set is an
  // immutable version in its own table rather than a column here: regeneration
  // must add a version, never overwrite one (architecture.md §4.3).
  opportunityVersions OpportunityVersion[]

  // Grounded Recommendations (roadmap Phase 6), versioned for the same reason
  // the Opportunities are.
  recommendationVersions       RecommendationVersion[]
  roadmapVersions              ImplementationRoadmapVersion[]
  reportVersions               ConsultantReportVersion[]
  documentPublications         DocumentPublication[]
  reportPdfArtifacts           ReportPdfArtifact[]
  documentNotificationAttempts DocumentNotificationAttempt[]
  clientFeedback               ClientFeedback[]
  feedbackReentries            FeedbackReentry[]

  invitations       ClientInvitation[]
  discoveryAccesses DiscoveryAccess[]
  notifications     Notification[]
  auditTrails       AuditTrail[]

  // Security, privacy and AI compliance (roadmap Phase 10). How this
  // engagement's content is classified, whether AI may assist with it, and
  // whether a legal obligation currently prevents its erasure. These are
  // engagement state on the aggregate root, not a parallel store: they are
  // asked before every AI request and before every erasure.
  dataClassification DataClassification @default(confidential)

  // The engagement's internal permission for AI assistance. **Not GDPR
  // consent** — the fields below record what makes the processing lawful.
  aiProcessingPermission                AiProcessingPermission @default(allowed)
  aiProcessingPermissionNotes           String?
  aiProcessingPermissionUpdatedAt       DateTime?
  aiProcessingPermissionUpdatedByUserId String?
  aiProcessingPermissionUpdatedBy       User?                  @relation("EngagementAiProcessingPermissionUpdatedBy", fields: [aiProcessingPermissionUpdatedByUserId], references: [id], onDelete: SetNull)

  // The privacy-processing record: what this engagement's personal data is
  // processed *for*, and what makes that lawful (roadmap Phase 10 corrections
  // §2). AI processing of personal data is refused while either is missing;
  // nothing here is ever back-filled, because an invented legal basis is worse
  // than none.
  processingPurpose                  String?
  legalBasis                         LegalBasis @default(not_assessed)
  legalBasisNote                     String?
  privacyProcessingConfirmedAt       DateTime?
  privacyProcessingConfirmedByUserId String?
  privacyProcessingConfirmedBy       User?      @relation("EngagementPrivacyProcessingConfirmedBy", fields: [privacyProcessingConfirmedByUserId], references: [id], onDelete: SetNull)

  // Real GDPR consent, recorded only where `legalBasis` is `consent`. A
  // withdrawn record is kept: the account of what was lawful *then* has to
  // survive the withdrawal.
  consentRecords EngagementConsentRecord[]

  // The engagement's screening against the workspace's standard DPIA.
  dpiaScreening                EngagementDpiaScreening @default(not_assessed)
  dpiaScreeningNote            String?
  dpiaScreeningUpdatedAt       DateTime?
  dpiaScreeningUpdatedByUserId String?
  dpiaScreeningUpdatedBy       User?                   @relation("EngagementDpiaScreeningUpdatedBy", fields: [dpiaScreeningUpdatedByUserId], references: [id], onDelete: SetNull)

  // A legal obligation to retain this engagement's data. It is the only thing
  // that blocks erasure: a retention period says how long data is kept by
  // default, a legal hold says it may not be removed at all yet.
  legalHold          Boolean   @default(false)
  legalHoldReason    String?
  legalHoldUpdatedAt DateTime?

  @@index([organizationId])
  @@index([workspaceId])
  @@index([owningManagerId])
  @@index([stage])
  @@index([discoveryStatus])
  @@index([createdAt])
  @@index([sensitiveData])
  @@index([gdprConcerns])
  @@index([dataClassification])
  @@index([aiProcessingPermission])
  @@index([legalBasis])
  @@index([dpiaScreening])
  @@index([legalHold])
}

// Real consent under GDPR Article 6(1)(a), for one engagement (roadmap Phase 10
// corrections §3).
//
// Deliberately narrow. It records that a named subject was shown a named
// consent text describing a named purpose, and when — and it stops there. It
// does **not** claim that a company representative's consent covers the
// personal data of that company's employees, customers or other third parties,
// and the product never asserts that it does. Anything wider is a legal
// question for a human, not a column.
//
// Records are never deleted or rewritten: a withdrawal sets the withdrawal
// fields, and the row stays as the account of what was lawful before it.
model EngagementConsentRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  // The exact wording agreed to, and the version it was published under. A
  // consent nobody can reproduce is not evidence.
  consentText        String
  consentTextVersion String

  // What the subject was told the processing is for. Held separately from the
  // engagement's own purpose so a later edit there cannot silently re-describe
  // what somebody consented to.
  processingPurpose String

  subjectName         String
  subjectRole         String?
  subjectOrganization String?

  privacyNoticeVersion String?

  grantedAt        DateTime @default(now())
  recordedByUserId String?
  recordedBy       User?    @relation("EngagementConsentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  withdrawnAt       DateTime?
  withdrawnByUserId String?
  withdrawnBy       User?     @relation("EngagementConsentWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)
  withdrawalNote    String?

  @@index([workspaceId])
  @@index([engagementId])
  @@index([withdrawnAt])
}

model ClientFeedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  sourcePublicationId String
  sourcePublication   DocumentPublication @relation(fields: [sourcePublicationId], references: [id], onDelete: Restrict)

  sourceReportVersionId          String
  sourceReportVersion            ConsultantReportVersion @relation(fields: [sourceReportVersionId], references: [id], onDelete: Restrict)
  sourceReportVersionNumber      Int
  sourceReportVersionPublishedAt DateTime

  submittedByUserId     String
  submittedBy           User     @relation("ClientFeedbackSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedAt           DateTime @default(now())
  submissionKey         String
  submissionContentHash String
  originalContent       String

  status               ClientFeedbackStatus          @default(submitted)
  classification       ClientFeedbackClassification?
  impactedStages       Json                          @default("[]")
  managerSummary       String?
  managerDecision      String?
  closedNoActionReason String?
  reviewedAt           DateTime?
  reviewedByUserId     String?
  reviewedBy           User?                         @relation("ClientFeedbackReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  revision Int @default(0)

  reentries FeedbackReentry[]

  // Idempotency is scoped to one publication and one submitter, so a retry key
  // cannot collide across clients, engagements or workspaces: the publication
  // fixes all three. Named explicitly because Prisma's derived name would
  // exceed PostgreSQL's identifier limit and be truncated.
  @@unique([sourcePublicationId, submittedByUserId, submissionKey], map: "ClientFeedback_publication_submitter_key_unique")
  @@index([workspaceId])
  @@index([engagementId])
  @@index([sourcePublicationId])
  @@index([sourceReportVersionId])
  @@index([submittedByUserId])
  @@index([status])
  @@index([submittedAt])
}

model FeedbackReentry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  feedbackId String
  feedback   ClientFeedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict)

  status         FeedbackReentryStatus @default(open)
  impactedStages Json
  plan           String
  outcomes       Json                  @default("[]")

  sourceDiscoveryFingerprint    String
  sourceAssessmentRevision      Int
  sourceAssessmentFingerprint   String
  sourceOpportunityVersionId    String?
  sourceRecommendationVersionId String?
  sourceRoadmapVersionId        String?

  // The published ReportVersion the re-entry started from. A real relation, so
  // the lineage `Feedback → source version → result version` cannot be left
  // pointing at nothing. `Restrict` matches the historical-version model: a
  // version that a re-entry records is preserved, never cascade-deleted.
  sourceReportVersionId String
  sourceReportVersion   ConsultantReportVersion @relation("FeedbackReentrySourceReportVersion", fields: [sourceReportVersionId], references: [id], onDelete: Restrict)

  openedAt       DateTime @default(now())
  openedByUserId String
  openedBy       User     @relation("FeedbackReentryOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)

  completedAt       DateTime?
  completedByUserId String?
  completedBy       User?     @relation("FeedbackReentryCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completionNote    String?

  revision Int @default(0)

  @@index([workspaceId])
  @@index([engagementId])
  @@index([feedbackId])
  @@index([status])
  @@index([openedAt])
  @@index([sourceReportVersionId])
}

// The curated Consulting Knowledge Base (roadmap Phase 5). It is its own table
// group, holds no client-specific content, and carries no workspace: both
// knowledge bases are product-level assets shared across workspaces, outside
// the Phase 3A isolation boundary (architecture.md §9; domain-model.md §3A.1).
// There is no foreign key from here into an engagement, and none from an
// engagement into here — engagements reference an entry by its stable `code`.
model ConsultingKnowledgeEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The stable curated identifier every reference uses — retrieval results,
  // curated relationships, and the codes an Analysis Run records.
  code       String                  @unique
  kind       ConsultingKnowledgeKind
  domainCode String
  title      String
  summary    String

  // A weak, additional retrieval signal. Retrieval is driven by the typed
  // relationships below, never by tags alone.
  tags Json

  // The curated vocabulary that resolves an engagement's own words into this
  // entry's code. It seeds the anchor set; it never ranks.
  matchTerms Json

  stageScopes Json

  // The explicit curated relationships retrieval traverses. Each slot holds
  // codes of exactly one kind; `relatedCodes` is the untyped slot for
  // cross-links that fit none of them.
  taxonomyCodes Json
  processCodes  Json
  problemCodes  Json
  useCaseCodes  Json
  relatedCodes  Json

  details Json

  // The curator's stable ordering within a kind — the first tie-breaker, and
  // what makes an equal-scoring result set reproducible.
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  // Bumped on every curated write. A write against a stale revision is refused
  // rather than silently overwriting another curator's change.
  revision Int @default(0)

  updatedByUserId String?
  updatedBy       User?   @relation("ConsultingKnowledgeCuratedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([domainCode])
  @@index([active])
  @@index([domainCode, kind, active])
}

// ---------------------------------------------------------------------------
// The curated Technology Knowledge Base (roadmap Phase 5A).
//
// A separate table group from both the Consulting Knowledge Base and the
// engagement tables, kept apart because AI technologies and models churn far
// faster than consulting methodology knowledge (domain-model.md §4.2). Like the
// Consulting Knowledge Base it carries **no workspace**: both knowledge bases
// are product-level assets shared across workspaces, outside the Phase 3A
// isolation boundary (architecture.md §9; domain-model.md §3A.1). There is no
// foreign key from here into an engagement, and none from an engagement into
// here — an engagement references a profile by its stable `code`.
//
// The **only** write path to TechnologyProfile is the Technology Curator
// applying an explicitly human-approved TechnologyUpdateProposal (§9.3).
// ---------------------------------------------------------------------------

// The top-level organizing concept. Categories are curated data rather than
// hard-coded types, so the set is extensible without a code change. The
// hierarchy is one level deep: nesting is added "only if a real second level
// appears" (architecture.md §6), so there is deliberately no parent column.
model TechnologyCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code    String @unique
  title   String
  summary String

  sortOrder Int     @default(0)
  active    Boolean @default(true)
  revision  Int     @default(0)

  updatedByUserId String?
  updatedBy       User?   @relation("TechnologyCategoryCuratedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  profiles TechnologyProfile[]

  @@index([active])
  @@index([sortOrder])
}

// The trusted official origin an update legitimately comes from — the
// provenance concept that makes Technology Knowledge Base updates auditable
// (domain-model.md §2). Deliberately distinct from the AI Providers category:
// a Source is curation provenance, an AI Providers profile is curated content.
model TechnologySource {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code    String @unique
  name    String
  summary String

  // Where the source officially publishes — announcement feed, model cards,
  // documentation. Structured records rather than a blob, so a proposal can
  // cite which channel it derives from.
  officialChannels Json

  active   Boolean @default(true)
  revision Int     @default(0)

  updatedByUserId String?
  updatedBy       User?   @relation("TechnologySourceCuratedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([active])
}

// One AI technology, tool, or model. Classified under **exactly one**
// Technology Category — an explicit documented invariant, not a modeling
// convenience (domain-model.md §2, §4.2, §8; architecture.md §9.2), which is
// why `categoryCode` is a required relation rather than a nullable list.
//
// The content facets are exactly the four the documentation names: role,
// strengths, limitations, suitability. They are stored as one validated Json
// `details` payload paired with a Zod schema in `shared/` (architecture.md §6).
model TechnologyProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code String @unique

  categoryCode String
  category     TechnologyCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  title   String
  summary String
  details Json

  // The curated vocabulary that resolves a stage's free text into this
  // profile's code. It seeds retrieval; it is never matched against prose.
  matchTerms Json

  // A weak, additional retrieval signal. Tags never select a profile alone.
  tags Json

  status    TechnologyProfileStatus @default(active)
  sortOrder Int                     @default(0)

  // Where this profile's current content came from. The default is the weaker
  // claim on purpose: `product_seed` asserts no approval, so a row that somehow
  // arrived without going through the curator can never read as approved.
  origin TechnologyProfileOrigin @default(product_seed)

  // The official origins the product attributes its **seeded** content to.
  // Populated only while `origin` is `product_seed`; the curator's apply path
  // clears it and hands the question to the Technology Update History, so the
  // declaration and the audit record can never disagree. Empty is the honest
  // default — "no official source declared" — so the curator's clearing write
  // and a row that arrives without one read identically.
  originSourceCodes Json @default("[]")

  // Bumped by each applied change, so a reader can tell how often a profile
  // has moved. It is written only by the curator's apply path.
  revision Int @default(0)

  historyEntries TechnologyUpdateHistory[]

  @@index([categoryCode])
  @@index([status])
  @@index([categoryCode, status])
  @@index([origin])
}

// The governance record of a *proposed* curation change, approved or rejected
// (domain-model.md §2). It is deliberately **not** an Analysis Run: an Analysis
// Run always belongs to an engagement, and curation belongs to none.
model TechnologyUpdateProposal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeKind TechnologyChangeKind

  // Which profile the change targets, and under which category. Held as codes
  // rather than relations because a `create` names a profile that does not
  // exist yet, and because a decided proposal must keep saying what it said
  // even if the profile is later retired.
  profileCode  String
  categoryCode String

  // The profile as the curator proposes it should read. Null for a
  // `deprecate`, which retires a profile rather than restating it.
  proposedProfile Json?

  rationale   String
  assumptions Json
  gaps        Json

  // The trusted official origins this proposal derives from — at least one,
  // enforced by the schema in `shared/`. A proposal without a source is
  // unattributable (architecture.md §9.3).
  sourceCodes Json

  status TechnologyProposalStatus @default(pending)

  createdByUserId String?
  createdBy       User?   @relation("TechnologyProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // The explicit human decision. Nothing reaches the knowledge base without it.
  decidedAt       DateTime?
  decidedByUserId String?
  decidedBy       User?     @relation("TechnologyProposalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decisionNote    String?

  // When the approved change actually reached the knowledge base. Recorded
  // separately from the approval so "approved but not applied" is never
  // mistaken for "applied".
  appliedAt DateTime?

  historyEntries TechnologyUpdateHistory[]

  @@index([status])
  @@index([profileCode])
  @@index([createdAt])
}

// The append-only audit log of **approved, applied** revisions only
// (domain-model.md §2; architecture.md §9.3).
//
// Append-only by construction, exactly as AuditTrail is: the repository exposes
// append and read only, and there is no update or delete path in code. It has
// no `updatedAt` column for the same reason — an entry is never rewritten.
//
// It never records a rejected proposal, and it is separate from the
// engagement-scoped Analysis Run and the workspace-scoped Audit Trail. Three
// logs, three purposes, never merged.
model TechnologyUpdateHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // The approved proposal this entry originates from. Exactly one.
  proposalId String
  proposal   TechnologyUpdateProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  profileCode String
  profile     TechnologyProfile @relation(fields: [profileCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  categoryCode String
  changeKind   TechnologyChangeKind

  // The Technology Source references, **preserved here** rather than read back
  // through the proposal: the history has to keep answering "from which
  // official origin did this come?" even if the registry later changes.
  sourceCodes Json

  // What the profile read as immediately after the change was applied.
  appliedProfile Json

  approvedByUserId String?
  approvedBy       User?   @relation("TechnologyHistoryApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  appliedAt DateTime @default(now())

  @@index([profileCode])
  @@index([categoryCode])
  @@index([appliedAt])
  @@index([proposalId])
}

model AnalysisRun {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  // Which methodology stage the run supported, so runs can be filtered by stage
  // while still rolling up to the engagement (architecture.md §8). Runs recorded
  // before the assessment stage existed carry the legacy `analysis` value.
  stage String

  provider String
  model    String

  promptVersion     String?
  promptFingerprint String?
  latencyMs         Int?

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  costEstimateUsd Decimal? @db.Decimal(10, 6)

  // Objective quality signals recorded on every run.
  jsonParseSuccess Boolean
  schemaValid      Boolean

  // Subjective quality signals are reserved for a genuine evaluator and are
  // left unpopulated until one exists — no placeholder scores are written
  // (roadmap Phase 0; architecture.md §5; coding-standards.md §8 "No fake
  // quality signals").
  relevance         String?
  hallucinationRisk String?
  businessValue     String?
  actionability     String?

  errorMessage String?

  // Which curated Consulting Knowledge Base entries grounded this run, by their
  // stable codes, in the order the retrieval selected them (roadmap Phase 5;
  // architecture.md §5 "grounding references are captured alongside the
  // generated content"). Codes, not foreign keys: the reference direction is
  // engagement → knowledge, and the record must stay faithful to the knowledge
  // as it stood even if an entry is later renamed or deactivated
  // (architecture.md §4.3, §9.4). Null on runs from before the knowledge base
  // existed, empty for a stage that retrieves nothing.
  knowledgeEntryCodes Json?

  // Which curated Technology Knowledge Base profiles grounded this run, by their
  // stable codes, in the order the retrieval selected them (roadmap Phase 6).
  // Kept in its own column rather than folded into `knowledgeEntryCodes`: the
  // two knowledge bases are independent subsystems and are named specifically,
  // never as an undifferentiated "knowledge base" (coding-standards.md §12).
  // Null on runs from a stage that does not retrieve technology knowledge.
  technologyProfileCodes Json?

  // Compliance metadata, recorded on every AI-assisted run (roadmap Phase 10:
  // "Record compliance metadata for every AI-assisted Analysis Run, including
  // provider, model, purpose, prompt version, input classification, output
  // classification, PII redaction status, output scan outcome, and human review
  // status"). Provider,
  // model and prompt version are the columns above — this phase adds the five
  // that were missing rather than starting a parallel record.
  //
  // Nullable because runs recorded before this phase have no compliance
  // decision behind them, and a back-filled value would be an invented one.
  purpose              String?
  inputClassification  DataClassification?
  outputClassification DataClassification?
  piiRedactionStatus   PiiRedactionStatus?
  // How many distinct personal identifiers were replaced. The values
  // themselves are never recorded: a log of what was removed would defeat the
  // removal.
  piiRedactionCount    Int?
  // What the re-scan of the model's response found. The output classification
  // above is assigned *after* this scan, never inferred from the input alone
  // (roadmap Phase 10 corrections §5).
  outputScanOutcome    AiOutputScanOutcome?
  humanReviewStatus    HumanReviewStatus?
  humanReviewedAt      DateTime?

  // The governed Workspace approval the request was permitted under. Null on
  // runs recorded before the approval relation existed, and on runs that were
  // refused before one was resolved.
  aiModelApprovalId String?
  aiModelApproval   WorkspaceAiModelApproval? @relation(fields: [aiModelApprovalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  opportunityVersions    OpportunityVersion[]
  recommendationVersions RecommendationVersion[]
  roadmapVersions        ImplementationRoadmapVersion[]
  reportVersions         ConsultantReportVersion[]

  @@index([engagementId])
  @@index([workspaceId])
  @@index([provider, model])
  @@index([createdAt])
  @@index([piiRedactionStatus])
  @@index([outputScanOutcome])
  @@index([humanReviewStatus])
  @@index([aiModelApprovalId])
}

// One immutable, versioned snapshot of the engagement's Implementation Roadmap
// (roadmap Phase 7). It mirrors RecommendationVersion narrowly: generation
// creates a new active version, older versions are superseded and readable, and
// consultant edits autosave into the active version behind optimistic
// concurrency. The roadmap references Recommendation identities and copied
// Implementation Pattern reasoning; it never mutates either source.
model ImplementationRoadmapVersion {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        RoadmapVersionStatus @default(active)

  content     Json
  reviewState RoadmapReviewState @default(ai_draft)

  sourceRecommendationVersionId     String
  sourceRecommendationVersion       RecommendationVersion @relation(fields: [sourceRecommendationVersionId], references: [id], onDelete: Cascade)
  sourceRecommendationVersionNumber Int
  sourceRecommendationFingerprint   String

  analysisRunId String?
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  createdByUserId String?
  createdBy       User?    @relation("RoadmapVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lastModifiedAt       DateTime @default(now())
  lastModifiedByUserId String?
  lastModifiedBy       User?    @relation("RoadmapVersionLastModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)

  revision Int @default(0)

  @@unique([engagementId, versionNumber])
  @@index([engagementId, status])
  @@index([workspaceId])
  @@index([sourceRecommendationVersionId])
  @@index([createdAt])
}

model ConsultantReportVersion {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        ReportVersionStatus @default(active)
  reviewState   ReportReviewState   @default(draft)

  // How this document is classified (roadmap Phase 10). A report assembled from
  // an engagement's content is never less protected than that content, so a
  // version is created carrying at least its engagement's classification.
  dataClassification DataClassification @default(confidential)

  content Json

  sourceDiscoveryFingerprint        String
  sourceAssessmentRevision          Int
  sourceAssessmentFingerprint       String
  sourceOpportunityVersionId        String
  sourceOpportunityVersionNumber    Int
  sourceOpportunityFingerprint      String
  sourceRecommendationVersionId     String
  sourceRecommendationVersionNumber Int
  sourceRecommendationFingerprint   String
  sourceRoadmapVersionId            String
  sourceRoadmapVersionNumber        Int
  sourceRoadmapFingerprint          String
  sourceSnapshot                    Json

  analysisRunId String?
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  createdByUserId String?
  createdBy       User?    @relation("ReportVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lastModifiedAt       DateTime @default(now())
  lastModifiedByUserId String?
  lastModifiedBy       User?    @relation("ReportVersionLastModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)

  revision Int @default(0)

  approvedAt                DateTime?
  approvedByUserId          String?
  approvedBy                User?     @relation("ReportVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedSourceFingerprint String?

  publications      DocumentPublication[]
  pdfArtifacts      ReportPdfArtifact[]
  clientFeedback    ClientFeedback[]
  feedbackReentries FeedbackReentry[]     @relation("FeedbackReentrySourceReportVersion")

  @@unique([engagementId, versionNumber])
  @@index([engagementId, status])
  @@index([workspaceId])
  @@index([sourceOpportunityVersionId])
  @@index([sourceRecommendationVersionId])
  @@index([sourceRoadmapVersionId])
  @@index([createdAt])
  @@index([approvedByUserId])
  @@index([approvedAt])
}

model DocumentPublication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  reportVersionId String
  reportVersion   ConsultantReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)

  pdfArtifactId String?
  pdfArtifact   ReportPdfArtifact? @relation(fields: [pdfArtifactId], references: [id], onDelete: Restrict)

  status DocumentPublicationStatus @default(active)

  clientUserId String?
  clientUser   User?   @relation("DocumentPublishedForClient", fields: [clientUserId], references: [id], onDelete: SetNull)

  title          String?
  managerMessage String?

  publishedAt       DateTime @default(now())
  publishedByUserId String
  publishedBy       User     @relation("DocumentPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)

  revokedAt       DateTime?
  revokedByUserId String?
  revokedBy       User?     @relation("DocumentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  emailNotificationAttemptedAt DateTime?
  emailNotificationDeliveredAt DateTime?
  emailNotificationFailure     String?

  notificationAttempts DocumentNotificationAttempt[]
  clientFeedback       ClientFeedback[]

  @@index([workspaceId])
  @@index([engagementId])
  @@index([reportVersionId])
  @@index([pdfArtifactId])
  @@index([clientUserId])
  @@index([status])
  @@index([publishedAt])
}

model ReportPdfArtifact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  reportVersionId String
  reportVersion   ConsultantReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)

  rendererVersion String
  contentHash     String
  // The hash of the *rendered* PDF, computed before encryption, so it still
  // identifies the document a client received once the stored bytes are
  // ciphertext.
  pdfHash         String
  bytes           Bytes

  // Encryption at rest (roadmap Phase 10). `null` means the bytes are stored as
  // rendered — the state of every artifact produced before this phase, kept
  // readable rather than rewritten. A value names the algorithm and the key the
  // ciphertext was produced with, so a key rotation can tell which artifacts it
  // still has to re-wrap.
  encryptionAlgorithm String?
  encryptionKeyId     String?

  publications DocumentPublication[]

  @@unique([reportVersionId, rendererVersion])
  @@index([workspaceId])
  @@index([engagementId])
  @@index([reportVersionId])
  @@index([pdfHash])
  @@index([createdAt])
}

model DocumentNotificationAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  publicationId String
  publication   DocumentPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  requestKey        String
  outcome           DocumentNotificationOutcome
  errorCategory     String?
  providerMessageId String?

  @@unique([publicationId, requestKey])
  @@index([workspaceId])
  @@index([engagementId])
  @@index([publicationId])
  @@index([outcome])
  @@index([createdAt])
}

// One immutable, versioned snapshot of the engagement's prioritized
// Opportunities (roadmap Phase 4).
//
// Generation creates version 1; every regeneration creates the next version and
// supersedes — never rewrites — the one before it, so what the consultant saw
// and reasoned about at each iteration stays recoverable. The consultant's
// edits and manual ordering are autosaved *within* the active version, so
// editing does not multiply versions.
//
// The version records what produced it and what it was derived from: the
// Analysis Run behind the generation (architecture.md §8), the Assessment
// revision, and a fingerprint of the Assessment's content, which is what lets
// the active version be recognized as stale after the Assessment changes.
model OpportunityVersion {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        OpportunityVersionStatus @default(active)

  // The validated prioritization. Still-stabilizing stage output is stored as
  // Json paired with a Zod schema in `shared/` (architecture.md §6).
  content     Json
  reviewState OpportunityReviewState @default(ai_draft)

  // The Assessment this version was derived from.
  sourceAssessmentRevision    Int
  sourceAssessmentFingerprint String

  // The Analysis Run behind the generation. Nullable only because recording a
  // run is best-effort and must never fail the consultant's stage
  // (coding-standards.md §7); the generation path always attempts the link.
  analysisRunId String?
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  createdByUserId String?
  createdBy       User?    @relation("OpportunityVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lastModifiedAt       DateTime @default(now())
  lastModifiedByUserId String?
  lastModifiedBy       User?    @relation("OpportunityVersionLastModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)

  // The optimistic-concurrency token. An autosave carries the revision it read
  // and is refused if the version has moved on since, so two people editing the
  // same version cannot silently overwrite each other (architecture.md §13).
  revision Int @default(0)

  recommendationVersions RecommendationVersion[]

  // Version numbers are unique per engagement, which is also what makes two
  // regenerations racing each other fail loudly instead of both "winning". The
  // migration adds a partial unique index enforcing at most one *active*
  // version per engagement — a guarantee Prisma's schema language cannot yet
  // express, so it lives in the migration alongside this note.
  @@unique([engagementId, versionNumber])
  @@index([engagementId, status])
  @@index([workspaceId])
  @@index([createdAt])
}

// One immutable, versioned snapshot of the engagement's grounded
// Recommendations (roadmap Phase 6).
//
// It follows the Opportunity version's shape deliberately rather than
// abstracting over it: the two stages share a lifecycle — generate, review,
// edit, accept, regenerate — and a stage that stored its output differently
// would have to be reasoned about differently. Regeneration supersedes rather
// than overwrites, so what the consultant reviewed at each iteration stays
// recoverable; edits are autosaved *within* the active version, so editing does
// not multiply versions (architecture.md §4.3).
//
// The version records what produced it and what it was derived from: the
// Analysis Run behind the generation (architecture.md §8), the Opportunity
// version it was matched against, and a fingerprint of that version's content,
// which is what lets the active version be recognized as stale after the
// prioritization changes.
//
// The grounding itself — which Consulting Knowledge Base entries justify each
// recommendation, and which Technology Profiles are behind the technologies it
// names — lives inside `content`, as *codes plus copied reasoning*. There is
// deliberately no foreign key into either knowledge base: the reference
// direction is engagement → knowledge, and the record must stay faithful to the
// knowledge as it stood even if an entry is later re-worded or retired
// (architecture.md §9.4).
model RecommendationVersion {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        RecommendationVersionStatus @default(active)

  // The validated recommendation set. Still-stabilizing stage output is stored
  // as Json paired with a Zod schema in `shared/` (architecture.md §6).
  content     Json
  reviewState RecommendationReviewState @default(ai_draft)

  // The prioritized Opportunities this version was matched against.
  sourceOpportunityVersionId     String
  sourceOpportunityVersion       OpportunityVersion @relation(fields: [sourceOpportunityVersionId], references: [id], onDelete: Cascade)
  sourceOpportunityVersionNumber Int
  sourceOpportunityFingerprint   String

  // The Analysis Run behind the generation. Nullable only because recording a
  // run is best-effort and must never fail the consultant's stage
  // (coding-standards.md §7); the generation path always attempts the link.
  analysisRunId String?
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  createdByUserId String?
  createdBy       User?    @relation("RecommendationVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lastModifiedAt       DateTime @default(now())
  lastModifiedByUserId String?
  lastModifiedBy       User?    @relation("RecommendationVersionLastModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)

  // The optimistic-concurrency token. An autosave carries the revision it read
  // and is refused if the version has moved on since (architecture.md §13).
  revision Int @default(0)

  roadmapVersions ImplementationRoadmapVersion[]

  // As with the Opportunity versions, the migration adds a partial unique index
  // enforcing at most one *active* version per engagement — a guarantee Prisma's
  // schema language cannot yet express, so it lives in the migration alongside
  // this note.
  @@unique([engagementId, versionNumber])
  @@index([engagementId, status])
  @@index([workspaceId])
  @@index([sourceOpportunityVersionId])
  @@index([createdAt])
}

model Workspace {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  users                        User[]
  organizations                Organization[]
  engagements                  Engagement[]
  analysisRuns                 AnalysisRun[]
  opportunityVersions          OpportunityVersion[]
  recommendationVersions       RecommendationVersion[]
  roadmapVersions              ImplementationRoadmapVersion[]
  reportVersions               ConsultantReportVersion[]
  documentPublications         DocumentPublication[]
  reportPdfArtifacts           ReportPdfArtifact[]
  documentNotificationAttempts DocumentNotificationAttempt[]
  clientFeedback               ClientFeedback[]
  feedbackReentries            FeedbackReentry[]
  invitations                  ClientInvitation[]
  discoveryAccesses            DiscoveryAccess[]
  notifications                Notification[]
  auditTrails                  AuditTrail[]
  compliancePolicy             WorkspaceCompliancePolicy?
  aiModelApprovals             WorkspaceAiModelApproval[]
  dpiaAssessment               WorkspaceDpiaAssessment?
  consentRecords               EngagementConsentRecord[]

  @@index([name])
  @@index([createdAt])
}

// The unified Compliance Policy of one workspace (roadmap Phase 10). Its three
// named parts — data handling, AI policy, and data retention — live on one row
// because the roadmap describes one policy per workspace, and because a rule
// split across records is a rule nobody can read in one place.
//
// Exactly one row per workspace, created with the workspace, so that "every
// engagement operates under an explicit Workspace Compliance Policy" holds from
// the moment the workspace exists rather than from the moment an administrator
// first opens the settings.
//
// The policy is mutable — an administrator configures AI usage, retention and
// data protection here without a code change. It is not a governance log: every
// change appends a `compliance_policy_updated` entry to the append-only Audit
// Trail, which is where the history of who changed what lives.
model WorkspaceCompliancePolicy {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Data handling: how client data may be stored, shared and exported.
  defaultDataClassification      DataClassification @default(confidential)
  clientDataExportPermitted      Boolean            @default(true)
  documentDownloadLinkTtlMinutes Int                @default(15)
  encryptDocumentsAtRest         Boolean            @default(true)
  requireEncryptedTransport      Boolean            @default(true)

  // AI policy: whether AI processing is permitted at all, whether confidential
  // information may be processed, whether personal identifiers are redacted
  // before a prompt is sent, and whether human approval is required before AI
  // output becomes accepted engagement content.
  //
  // Which provider and model are approved is deliberately **not** here: an
  // approval carries a contract status, a processing region, retention and
  // training decisions and an approving human, which a free-text list cannot
  // hold. It lives in `WorkspaceAiModelApproval`.
  aiProcessingPermitted             Boolean @default(true)
  confidentialAiProcessingPermitted Boolean @default(true)
  redactPersonalDataBeforeAi        Boolean @default(true)
  humanApprovalRequiredForAiOutput  Boolean @default(true)

  // Privacy processing: which legal bases this workspace's engagements may
  // select, and which one a new engagement starts from. A default is a starting
  // point, never a determination — the effective basis is always the individual
  // engagement's own.
  supportedLegalBases Json
  defaultLegalBasis   LegalBasis @default(not_assessed)

  // Data retention: how long each kind of record is kept. `null` means "kept
  // until explicitly erased" — an explicit decision, not an unset field.
  engagementRetentionDays Int?
  documentRetentionDays   Int?
  auditRetentionDays      Int?
  aiArtifactRetentionDays Int?

  // Configurable rules, so a new jurisdiction or a client's own identifier
  // scheme is a policy change rather than a code change (roadmap Phase 10:
  // "keeping regulatory rules configurable rather than hard-coded"). Validated
  // against the Zod schemas in `shared/compliance.schema.ts` at the boundary.
  personalIdentifierRules Json
  regulatoryFrameworks    Json

  // When an administrator last configured the policy deliberately, as opposed
  // to it standing at the values the workspace was created with.
  configuredAt       DateTime?
  configuredByUserId String?
  configuredBy       User?     @relation("CompliancePolicyConfiguredBy", fields: [configuredByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([configuredByUserId])
}

// One workspace's approval of one provider/model for AI processing (roadmap
// Phase 10 corrections §6).
//
// **Two layers, deliberately separate.** The source-backed reusable facts about
// a provider — its processing regions, published retention and training policy,
// DPA and subprocessor documentation, lifecycle status, and the official source
// each was read from — belong to the shared Technology Knowledge Base and change
// only through the Technology Update Proposal approval flow. *This* row holds
// what is nobody else's business: the workspace's own contract reference, the
// region it selected, the decisions it took, and the Administrator who approved
// them. A workspace's commercial arrangements are not curated knowledge.
//
// The AI compliance gate resolves the effective approval through this relation
// rather than matching a free-text string, so an approval is a decision with an
// author rather than a name on a list.
model WorkspaceAiModelApproval {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // The provider and model as the running deployment names them — what the gate
  // matches against, and therefore the deployment's identity rather than a
  // display name.
  provider String
  model    String

  // The Technology Profile whose source-backed facts were reviewed, and the
  // revision that was reviewed. Held as a code rather than a relation for the
  // same reason a proposal is: a profile may later be retired, and this
  // decision must keep saying what it said. Null on an approval carried over
  // from the free-text lists — which is exactly why such a row is `needs_review`.
  technologyProfileCode   String?
  reviewedProfileRevision Int?

  status       AiModelApprovalStatus @default(needs_review)
  // Why the approval is awaiting review, where the product knows. Names facts
  // about the provider, never an engagement.
  statusReason String?

  dpaStatus                     DpaStatus               @default(not_assessed)
  dpaReference                  String?
  processingRegion              String?
  promptRetention               PromptRetentionDecision @default(retained_unknown)
  trainingUse                   TrainingUseDecision     @default(unknown)
  thirdCountryTransferMechanism String?

  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?     @relation("AiModelApprovalApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lastReviewedAt   DateTime?

  analysisRuns AnalysisRun[]

  // One decision per provider/model per workspace. A second row for the same
  // pair would be two answers to one question.
  @@unique([workspaceId, provider, model])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([technologyProfileCode])
}

// The workspace's data protection impact assessment (DPIA/DSFA) for the
// **standard** processing operation (roadmap Phase 10 corrections §8).
//
// Minimal and human-controlled: the product records status, scope, rationale, a
// reference to the assessment document, who assessed and approved it, and when
// it is next due. It identifies risk indicators elsewhere but never makes the
// legal determination — that is a human's, and this row is where their answer
// is written down. It is not a case-management system and not a high-risk
// classification engine.
model WorkspaceDpiaAssessment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status WorkspaceDpiaStatus @default(not_started)

  scope             String?
  rationale         String?
  // Where the assessment document lives. A reference, never the document.
  documentReference String?

  assessedByUserId String?
  assessedBy       User?   @relation("WorkspaceDpiaAssessedBy", fields: [assessedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId String?
  approvedBy       User?   @relation("WorkspaceDpiaApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  assessedAt  DateTime?
  reviewDueAt DateTime?

  @@index([workspaceId])
  @@index([status])
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  email           String
  displayName     String?
  role            UserRole
  emailVerifiedAt DateTime?

  // The authentication identity behind this workspace membership. The
  // credential itself lives in the access/auth table group and is owned by the
  // authentication provider; the consulting domain holds only the reference
  // (architecture.md §1.13, §7A.1). Nullable because the Phase 3A migration's
  // placeholder owner exists before anyone can sign in, and because a
  // self-registered client has an authentication identity before a consultant
  // associates them with a workspace.
  authUserId String?   @unique
  authUser   AuthUser? @relation(fields: [authUserId], references: [id], onDelete: SetNull)

  issuedInvitations              ClientInvitation[]             @relation("InvitationIssuer")
  acceptedInvitations            ClientInvitation[]             @relation("InvitationAcceptedBy")
  discoveryAccessGranted         DiscoveryAccess[]              @relation("DiscoveryAccessGrantor")
  discoveryAccesses              DiscoveryAccess[]              @relation("DiscoveryAccessRecipient")
  ownedEngagements               Engagement[]                   @relation("EngagementOwnedBy")
  createdOpportunityVersions     OpportunityVersion[]           @relation("OpportunityVersionCreatedBy")
  modifiedOpportunityVersions    OpportunityVersion[]           @relation("OpportunityVersionLastModifiedBy")
  createdRecommendationVersions  RecommendationVersion[]        @relation("RecommendationVersionCreatedBy")
  modifiedRecommendationVersions RecommendationVersion[]        @relation("RecommendationVersionLastModifiedBy")
  createdRoadmapVersions         ImplementationRoadmapVersion[] @relation("RoadmapVersionCreatedBy")
  modifiedRoadmapVersions        ImplementationRoadmapVersion[] @relation("RoadmapVersionLastModifiedBy")
  createdReportVersions          ConsultantReportVersion[]      @relation("ReportVersionCreatedBy")
  modifiedReportVersions         ConsultantReportVersion[]      @relation("ReportVersionLastModifiedBy")
  approvedReportVersions         ConsultantReportVersion[]      @relation("ReportVersionApprovedBy")
  publishedDocuments             DocumentPublication[]          @relation("DocumentPublishedBy")
  revokedDocumentPublications    DocumentPublication[]          @relation("DocumentRevokedBy")
  clientDocumentPublications     DocumentPublication[]          @relation("DocumentPublishedForClient")
  submittedClientFeedback        ClientFeedback[]               @relation("ClientFeedbackSubmittedBy")
  reviewedClientFeedback         ClientFeedback[]               @relation("ClientFeedbackReviewedBy")
  openedFeedbackReentries        FeedbackReentry[]              @relation("FeedbackReentryOpenedBy")
  completedFeedbackReentries     FeedbackReentry[]              @relation("FeedbackReentryCompletedBy")
  notifications                  Notification[]
  auditTrails                    AuditTrail[]
  curatedKnowledgeEntries        ConsultingKnowledgeEntry[]     @relation("ConsultingKnowledgeCuratedBy")

  // Security, privacy and AI compliance (roadmap Phase 10). Every relation is
  // SET NULL on delete, so removing a user never removes the compliance state
  // they last set — the decision survives its author.
  configuredCompliancePolicies    WorkspaceCompliancePolicy[] @relation("CompliancePolicyConfiguredBy")
  aiProcessingPermissionDecisions Engagement[]                @relation("EngagementAiProcessingPermissionUpdatedBy")
  privacyProcessingConfirmations  Engagement[]                @relation("EngagementPrivacyProcessingConfirmedBy")
  dpiaScreeningDecisions          Engagement[]                @relation("EngagementDpiaScreeningUpdatedBy")
  recordedConsents                EngagementConsentRecord[]   @relation("EngagementConsentRecordedBy")
  withdrawnConsents               EngagementConsentRecord[]   @relation("EngagementConsentWithdrawnBy")
  approvedAiModels                WorkspaceAiModelApproval[]  @relation("AiModelApprovalApprovedBy")
  assessedWorkspaceDpias          WorkspaceDpiaAssessment[]   @relation("WorkspaceDpiaAssessedBy")
  approvedWorkspaceDpias          WorkspaceDpiaAssessment[]   @relation("WorkspaceDpiaApprovedBy")

  // The Technology Knowledge Base's curation trail (roadmap Phase 5A). A user
  // is referenced by what they curated, proposed, decided, and approved; every
  // relation is SET NULL on delete, so removing a user never removes curated
  // knowledge or rewrites an append-only history entry.
  curatedTechnologyCategories TechnologyCategory[]       @relation("TechnologyCategoryCuratedBy")
  curatedTechnologySources    TechnologySource[]         @relation("TechnologySourceCuratedBy")
  createdTechnologyProposals  TechnologyUpdateProposal[] @relation("TechnologyProposalCreatedBy")
  decidedTechnologyProposals  TechnologyUpdateProposal[] @relation("TechnologyProposalDecidedBy")
  approvedTechnologyHistory   TechnologyUpdateHistory[]  @relation("TechnologyHistoryApprovedBy")

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([role])
}

// ---------------------------------------------------------------------------
// The access/auth table group (architecture.md §2, §6, §7A.1). These four
// models are owned by the authentication provider — Better Auth — and are
// deliberately kept out of the consulting-domain tables: no engagement-side
// code reads or writes them, and the consulting domain never stores a
// permanent password. Their shape is the provider's contract, which is why the
// field names are the provider's rather than this repository's usual style.
// ---------------------------------------------------------------------------

// Better Auth's `user` model: the authentication identity. Workspace
// membership and Role live on the consulting-domain `User`, which references
// this row — an identity can exist before it belongs to any workspace, which is
// exactly the state of a self-registered client awaiting Discovery Access.
model AuthUser {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions   AuthSession[]
  accounts   AuthAccount[]
  membership User?

  @@index([email])
}

// Better Auth's `session` model. Sessions are the provider's concern; the
// backend holds no engagement state between requests (architecture.md §2).
model AuthSession {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Better Auth's `account` model. For email/password sign-in this is where the
// hashed password lives — inside the auth boundary, never in a consulting
// table (coding-standards.md §6A).
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Better Auth's `verification` model: email-verification and password-reset
// tokens. It replaces the hand-rolled EmailVerificationToken and
// PasswordResetToken tables, so there is one implementation of these flows.
model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model ClientInvitation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdByUser   User   @relation("InvitationIssuer", fields: [createdByUserId], references: [id], onDelete: Restrict)

  email        String
  role         UserRole
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  tokenHash        String           @unique
  status           InvitationStatus @default(pending)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  acceptedByUserId String?
  acceptedByUser   User?            @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([engagementId])
  @@index([status])
}

model DiscoveryAccess {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("DiscoveryAccessRecipient", fields: [userId], references: [id], onDelete: Cascade)

  grantedByUserId String
  grantedByUser   User   @relation("DiscoveryAccessGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  status     DiscoveryAccessStatus @default(active)
  expiresAt  DateTime?
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@unique([engagementId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([engagementId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  kind    String
  payload Json
  readAt  DateTime?

  @@index([workspaceId])
  @@index([userId])
  @@index([engagementId])
  @@index([kind])
}

model AuditTrail {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  eventType String
  payload   Json

  @@index([workspaceId])
  @@index([userId])
  @@index([engagementId])
  @@index([eventType])
  @@index([createdAt])
}
