generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CompanySize {
  solo
  micro
  small
  medium
  large
  enterprise
}

enum Level {
  low
  medium
  high
}

enum ProcessFrequency {
  rarely
  monthly
  weekly
  daily
  many_times_per_day
}

enum DataAvailability {
  none
  unknown
  restricted
  available
}

enum DataQuality {
  poor
  mixed
  good
  unknown
}

enum Timeline {
  asap
  this_quarter
  this_year
  unknown
}

enum Currency {
  EUR
  USD
  GBP
  OTHER
}

enum UserRole {
  ADMIN
  MANAGER
  CLIENT
}

enum ConsultingKnowledgeKind {
  business_domain
  business_process
  business_problem
  customer_operations_taxonomy
  discovery_question
  assessment_framework
  ai_readiness_criterion
  ai_use_case
  solution_pattern
  implementation_pattern
  roi_model
  risk_model
  best_practice
  follow_up_template
}

// Whether a Technology Profile is current or has been retired (roadmap Phase
// 5A). A deprecated profile stays readable and stays citable by whatever
// already referenced it, but retrieval never selects it again.
enum TechnologyProfileStatus {
  active
  deprecated
}

// How a Technology Profile's current content came to be (roadmap Phase 5A).
// It is **origin metadata, not approval history**: `product_seed` is content
// the product shipped in its initial catalogue and that no human approved
// through the curator, so it has no Technology Update History entry;
// `curator` is content applied from an explicitly approved proposal, from
// which point the append-only history is the record.
enum TechnologyProfileOrigin {
  product_seed
  curator
}

// What a Technology Update Proposal does to the Technology Knowledge Base —
// the three changes the domain model names: "new, revised, or deprecated
// technology/model information" (domain-model.md §2).
enum TechnologyChangeKind {
  create
  revise
  deprecate
}

// Where a Technology Update Proposal stands. `pending` is the only state from
// which the knowledge base can still change; both decisions are terminal, so a
// decided proposal is never re-decided or re-applied (architecture.md §9.3).
enum TechnologyProposalStatus {
  pending
  approved
  rejected
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum DiscoveryAccessStatus {
  pending
  active
  revoked
  expired
}

// Where the Discovery Profile stands in its review workflow (Phase 2
// Extension; domain-model.md §3A.3). Submission is a review checkpoint, not a
// lock: discovery stays revisable in every state, and acceptance never ends the
// ability to revise it later.
enum DiscoveryStatus {
  draft
  submitted
  returned
  accepted
}

// Who acted on discovery. Until Phase 3A delivers authentication this is a
// declared role rather than an authenticated identity — it decides which
// workflow transitions the domain permits; it is not access control.
enum DiscoveryActor {
  consultant
  client
}

// Where the Assessment stands in the human-in-the-loop cycle (roadmap Phase 3).
// AI output is persisted as an unreviewed draft; once the consultant edits or
// accepts it, regenerating requires their explicit intent so their work is never
// silently overwritten (architecture.md §5; agent-rules.md §10).
enum AssessmentReviewState {
  ai_draft
  consultant_edited
  accepted
}

// Where the prioritized Opportunities stand in the human-in-the-loop cycle
// (roadmap Phase 4). It mirrors AssessmentReviewState deliberately: each stage
// carries its own review marker, so neither stage's stored contract moves when
// the other's does.
enum OpportunityReviewState {
  ai_draft
  consultant_edited
  accepted
}

// Whether an Opportunity version is the one being worked on or the preserved
// record of what was prioritized earlier (roadmap Phase 4). Regeneration
// supersedes rather than overwrites: no version is ever rewritten or deleted,
// mirroring append-only Consultant Report versions (architecture.md §4.3).
enum OpportunityVersionStatus {
  active
  superseded
}

// Where the grounded Recommendations stand in the human-in-the-loop cycle
// (roadmap Phase 6). It mirrors the two stages before it deliberately: each
// stage carries its own review marker, so neither stage's stored contract moves
// when another's does.
enum RecommendationReviewState {
  ai_draft
  consultant_edited
  accepted
}

// Whether a Recommendation version is the one being worked on or the preserved
// record of what was recommended earlier (roadmap Phase 6).
enum RecommendationVersionStatus {
  active
  superseded
}

enum RoadmapReviewState {
  ai_draft
  consultant_edited
  accepted
}

enum RoadmapVersionStatus {
  active
  superseded
}

enum ReportReviewState {
  draft
  manager_review
  approved
}

enum ReportVersionStatus {
  active
  superseded
}

enum DocumentPublicationStatus {
  active
  revoked
  superseded
}

enum DocumentNotificationOutcome {
  pending
  sent
  failed
}

// Where an engagement currently stands in the consulting methodology
// (domain-model.md §3). Phase 1 only tracks the stage marker; later phases
// add the content each stage produces. `discovery` is the first stage, so a
// freshly-created (still empty) engagement starts there.
enum EngagementStage {
  discovery
  assessment
  prioritization
  solution_matching
  roadmap
  report
}

// The grouping of a client's engagements — identity and company-level context
// only, deliberately NOT a customer-relationship record (domain-model.md §2,
// §6; architecture.md §4.2). One Organization owns many Engagements and holds
// no methodology state itself.
model Organization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  industry    String?
  companySize CompanySize?
  geography   String?
  notes       String?

  engagements Engagement[]

  @@index([workspaceId])
  @@index([name])
  @@index([createdAt])
}

// The primary engagement-side aggregate and single source of truth for all
// client-specific state (domain-model.md §2 "Engagement"; architecture.md
// §4.2). Phase 1 establishes the foundation: it belongs to an Organization,
// tracks its methodology `stage`, and can be created empty, saved, and
// resumed. Later phases attach discovery/assessment/opportunities/etc. content
// to this same record rather than a parallel store (roadmap Phase 1).
//
// Company-level identity/context (name, industry, size, geography) lives on the
// Organization, not here. The physical table was renamed from the legacy
// `ClientCase` in Phase 1 (architecture.md §6), so no `@@map` remains.
model Engagement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  owningManagerId String
  owningManager   User   @relation("EngagementOwnedBy", fields: [owningManagerId], references: [id], onDelete: Restrict)

  // A short label distinguishing engagements within one organization.
  title String?

  // Where the engagement currently stands (roadmap Phase 1).
  stage EngagementStage @default(discovery)

  analysisRuns AnalysisRun[]

  department String?

  // Discovery Profile. Stable facts use typed columns while evolving nested
  // lists use validated Json fields (architecture.md §6). Explicit gaps are
  // persisted alongside known facts so discovery can be resumed and revised.
  statedProblem  String?
  painPoints     Json?
  affectedUsers  Json?
  businessImpact String?
  urgency        Level?

  // Current process
  currentProcess   String?
  processSteps     Json?
  processFrequency ProcessFrequency?
  manualWorkLevel  Level?
  bottlenecks      Json?

  // Tools
  currentTools          Json?
  communicationChannels Json?
  integrationNeeds      Json?

  // Data
  dataTypes          Json?
  dataLocation       Json?
  dataAvailability   DataAvailability?
  dataQuality        DataQuality?
  sensitiveData      Boolean?
  sensitiveDataTypes Json?

  // Constraints
  gdprConcerns          Boolean?
  budgetAmount          Decimal?  @db.Decimal(12, 2)
  budgetCurrency        Currency?
  budgetNotes           String?
  timeline              Timeline?
  humanApprovalRequired Boolean?
  technicalConstraints  Json?

  // Goals
  desiredOutcome     String?
  successMetrics     Json?
  mvpScope           String?
  notes              String?
  missingInformation Json?

  // Value & measurement baseline (Phase 2 Extension). The metric structures are
  // still stabilizing, so the validated payload is stored as Json owned by the
  // Engagement aggregate, while the workflow's stable parts — status,
  // provenance, timestamps — are typed columns (architecture.md §6).
  valueMeasurementBaseline Json?

  // The Discovery review workflow: where the profile stands, who submitted it
  // and when, when the consultant reviewed it, the notes they returned it with,
  // and which section of the content came from whom. Provenance is a map of
  // section → consultant_captured | client_provided.
  discoveryStatus            DiscoveryStatus @default(draft)
  discoverySubmittedAt       DateTime?
  discoverySubmittedBy       DiscoveryActor?
  discoveryReviewedAt        DateTime?
  discoveryReturnNotes       String?
  discoveryContentProvenance Json?

  // Assessment (roadmap Phase 3). The findings of all dimensions are still
  // stabilizing, so the validated payload is stored as Json owned by the
  // Engagement aggregate rather than in a parallel store (architecture.md §6);
  // its review state is a stable, typed marker.
  assessment            Json?
  assessmentReviewState AssessmentReviewState?

  // How many times the Assessment has been written. It gives a reader a plain
  // number to refer to ("prioritized from Assessment revision 3"); whether a
  // derived stage has gone *stale* is decided by the content fingerprint the
  // derived stage recorded, not by this counter.
  assessmentRevision Int @default(0)

  // Prioritized Opportunities (roadmap Phase 4). Every generated set is an
  // immutable version in its own table rather than a column here: regeneration
  // must add a version, never overwrite one (architecture.md §4.3).
  opportunityVersions OpportunityVersion[]

  // Grounded Recommendations (roadmap Phase 6), versioned for the same reason
  // the Opportunities are.
  recommendationVersions RecommendationVersion[]
  roadmapVersions        ImplementationRoadmapVersion[]
  reportVersions         ConsultantReportVersion[]
  documentPublications   DocumentPublication[]
  reportPdfArtifacts     ReportPdfArtifact[]
  documentNotificationAttempts DocumentNotificationAttempt[]

  invitations       ClientInvitation[]
  discoveryAccesses DiscoveryAccess[]
  notifications     Notification[]
  auditTrails       AuditTrail[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([owningManagerId])
  @@index([stage])
  @@index([discoveryStatus])
  @@index([createdAt])
  @@index([sensitiveData])
  @@index([gdprConcerns])
}

// The curated Consulting Knowledge Base (roadmap Phase 5). It is its own table
// group, holds no client-specific content, and carries no workspace: both
// knowledge bases are product-level assets shared across workspaces, outside
// the Phase 3A isolation boundary (architecture.md §9; domain-model.md §3A.1).
// There is no foreign key from here into an engagement, and none from an
// engagement into here — engagements reference an entry by its stable `code`.
model ConsultingKnowledgeEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The stable curated identifier every reference uses — retrieval results,
  // curated relationships, and the codes an Analysis Run records.
  code       String                  @unique
  kind       ConsultingKnowledgeKind
  domainCode String
  title      String
  summary    String

  // A weak, additional retrieval signal. Retrieval is driven by the typed
  // relationships below, never by tags alone.
  tags Json

  // The curated vocabulary that resolves an engagement's own words into this
  // entry's code. It seeds the anchor set; it never ranks.
  matchTerms Json

  stageScopes Json

  // The explicit curated relationships retrieval traverses. Each slot holds
  // codes of exactly one kind; `relatedCodes` is the untyped slot for
  // cross-links that fit none of them.
  taxonomyCodes Json
  processCodes  Json
  problemCodes  Json
  useCaseCodes  Json
  relatedCodes  Json

  details Json

  // The curator's stable ordering within a kind — the first tie-breaker, and
  // what makes an equal-scoring result set reproducible.
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  // Bumped on every curated write. A write against a stale revision is refused
  // rather than silently overwriting another curator's change.
  revision Int @default(0)

  updatedByUserId String?
  updatedBy       User?   @relation("ConsultingKnowledgeCuratedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([domainCode])
  @@index([active])
  @@index([domainCode, kind, active])
}

// ---------------------------------------------------------------------------
// The curated Technology Knowledge Base (roadmap Phase 5A).
//
// A separate table group from both the Consulting Knowledge Base and the
// engagement tables, kept apart because AI technologies and models churn far
// faster than consulting methodology knowledge (domain-model.md §4.2). Like the
// Consulting Knowledge Base it carries **no workspace**: both knowledge bases
// are product-level assets shared across workspaces, outside the Phase 3A
// isolation boundary (architecture.md §9; domain-model.md §3A.1). There is no
// foreign key from here into an engagement, and none from an engagement into
// here — an engagement references a profile by its stable `code`.
//
// The **only** write path to TechnologyProfile is the Technology Curator
// applying an explicitly human-approved TechnologyUpdateProposal (§9.3).
// ---------------------------------------------------------------------------

// The top-level organizing concept. Categories are curated data rather than
// hard-coded types, so the set is extensible without a code change. The
// hierarchy is one level deep: nesting is added "only if a real second level
// appears" (architecture.md §6), so there is deliberately no parent column.
model TechnologyCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code    String @unique
  title   String
  summary String

  sortOrder Int     @default(0)
  active    Boolean @default(true)
  revision  Int     @default(0)

  updatedByUserId String?
  updatedBy       User?   @relation("TechnologyCategoryCuratedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  profiles TechnologyProfile[]

  @@index([active])
  @@index([sortOrder])
}

// The trusted official origin an update legitimately comes from — the
// provenance concept that makes Technology Knowledge Base updates auditable
// (domain-model.md §2). Deliberately distinct from the AI Providers category:
// a Source is curation provenance, an AI Providers profile is curated content.
model TechnologySource {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code    String @unique
  name    String
  summary String

  // Where the source officially publishes — announcement feed, model cards,
  // documentation. Structured records rather than a blob, so a proposal can
  // cite which channel it derives from.
  officialChannels Json

  active   Boolean @default(true)
  revision Int     @default(0)

  updatedByUserId String?
  updatedBy       User?   @relation("TechnologySourceCuratedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([active])
}

// One AI technology, tool, or model. Classified under **exactly one**
// Technology Category — an explicit documented invariant, not a modeling
// convenience (domain-model.md §2, §4.2, §8; architecture.md §9.2), which is
// why `categoryCode` is a required relation rather than a nullable list.
//
// The content facets are exactly the four the documentation names: role,
// strengths, limitations, suitability. They are stored as one validated Json
// `details` payload paired with a Zod schema in `shared/` (architecture.md §6).
model TechnologyProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code String @unique

  categoryCode String
  category     TechnologyCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  title   String
  summary String
  details Json

  // The curated vocabulary that resolves a stage's free text into this
  // profile's code. It seeds retrieval; it is never matched against prose.
  matchTerms Json

  // A weak, additional retrieval signal. Tags never select a profile alone.
  tags Json

  status    TechnologyProfileStatus @default(active)
  sortOrder Int                     @default(0)

  // Where this profile's current content came from. The default is the weaker
  // claim on purpose: `product_seed` asserts no approval, so a row that somehow
  // arrived without going through the curator can never read as approved.
  origin TechnologyProfileOrigin @default(product_seed)

  // The official origins the product attributes its **seeded** content to.
  // Populated only while `origin` is `product_seed`; the curator's apply path
  // clears it and hands the question to the Technology Update History, so the
  // declaration and the audit record can never disagree.
  originSourceCodes Json

  // Bumped by each applied change, so a reader can tell how often a profile
  // has moved. It is written only by the curator's apply path.
  revision Int @default(0)

  historyEntries TechnologyUpdateHistory[]

  @@index([categoryCode])
  @@index([status])
  @@index([categoryCode, status])
  @@index([origin])
}

// The governance record of a *proposed* curation change, approved or rejected
// (domain-model.md §2). It is deliberately **not** an Analysis Run: an Analysis
// Run always belongs to an engagement, and curation belongs to none.
model TechnologyUpdateProposal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeKind TechnologyChangeKind

  // Which profile the change targets, and under which category. Held as codes
  // rather than relations because a `create` names a profile that does not
  // exist yet, and because a decided proposal must keep saying what it said
  // even if the profile is later retired.
  profileCode  String
  categoryCode String

  // The profile as the curator proposes it should read. Null for a
  // `deprecate`, which retires a profile rather than restating it.
  proposedProfile Json?

  rationale   String
  assumptions Json
  gaps        Json

  // The trusted official origins this proposal derives from — at least one,
  // enforced by the schema in `shared/`. A proposal without a source is
  // unattributable (architecture.md §9.3).
  sourceCodes Json

  status TechnologyProposalStatus @default(pending)

  createdByUserId String?
  createdBy       User?   @relation("TechnologyProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // The explicit human decision. Nothing reaches the knowledge base without it.
  decidedAt       DateTime?
  decidedByUserId String?
  decidedBy       User?     @relation("TechnologyProposalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decisionNote    String?

  // When the approved change actually reached the knowledge base. Recorded
  // separately from the approval so "approved but not applied" is never
  // mistaken for "applied".
  appliedAt DateTime?

  historyEntries TechnologyUpdateHistory[]

  @@index([status])
  @@index([profileCode])
  @@index([createdAt])
}

// The append-only audit log of **approved, applied** revisions only
// (domain-model.md §2; architecture.md §9.3).
//
// Append-only by construction, exactly as AuditTrail is: the repository exposes
// append and read only, and there is no update or delete path in code. It has
// no `updatedAt` column for the same reason — an entry is never rewritten.
//
// It never records a rejected proposal, and it is separate from the
// engagement-scoped Analysis Run and the workspace-scoped Audit Trail. Three
// logs, three purposes, never merged.
model TechnologyUpdateHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // The approved proposal this entry originates from. Exactly one.
  proposalId String
  proposal   TechnologyUpdateProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  profileCode String
  profile     TechnologyProfile @relation(fields: [profileCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  categoryCode String
  changeKind   TechnologyChangeKind

  // The Technology Source references, **preserved here** rather than read back
  // through the proposal: the history has to keep answering "from which
  // official origin did this come?" even if the registry later changes.
  sourceCodes Json

  // What the profile read as immediately after the change was applied.
  appliedProfile Json

  approvedByUserId String?
  approvedBy       User?   @relation("TechnologyHistoryApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  appliedAt DateTime @default(now())

  @@index([profileCode])
  @@index([categoryCode])
  @@index([appliedAt])
  @@index([proposalId])
}

model AnalysisRun {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  // Which methodology stage the run supported, so runs can be filtered by stage
  // while still rolling up to the engagement (architecture.md §8). Runs recorded
  // before the assessment stage existed carry the legacy `analysis` value.
  stage String

  provider String
  model    String

  promptVersion     String?
  promptFingerprint String?
  latencyMs         Int?

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  costEstimateUsd Decimal? @db.Decimal(10, 6)

  // Objective quality signals recorded on every run.
  jsonParseSuccess Boolean
  schemaValid      Boolean

  // Subjective quality signals are reserved for a genuine evaluator and are
  // left unpopulated until one exists — no placeholder scores are written
  // (roadmap Phase 0; architecture.md §5; coding-standards.md §8 "No fake
  // quality signals").
  relevance         String?
  hallucinationRisk String?
  businessValue     String?
  actionability     String?

  errorMessage String?

  // Which curated Consulting Knowledge Base entries grounded this run, by their
  // stable codes, in the order the retrieval selected them (roadmap Phase 5;
  // architecture.md §5 "grounding references are captured alongside the
  // generated content"). Codes, not foreign keys: the reference direction is
  // engagement → knowledge, and the record must stay faithful to the knowledge
  // as it stood even if an entry is later renamed or deactivated
  // (architecture.md §4.3, §9.4). Null on runs from before the knowledge base
  // existed, empty for a stage that retrieves nothing.
  knowledgeEntryCodes Json?

  // Which curated Technology Knowledge Base profiles grounded this run, by their
  // stable codes, in the order the retrieval selected them (roadmap Phase 6).
  // Kept in its own column rather than folded into `knowledgeEntryCodes`: the
  // two knowledge bases are independent subsystems and are named specifically,
  // never as an undifferentiated "knowledge base" (coding-standards.md §12).
  // Null on runs from a stage that does not retrieve technology knowledge.
  technologyProfileCodes Json?

  createdAt DateTime @default(now())

  opportunityVersions    OpportunityVersion[]
  recommendationVersions RecommendationVersion[]
  roadmapVersions        ImplementationRoadmapVersion[]
  reportVersions         ConsultantReportVersion[]

  @@index([engagementId])
  @@index([workspaceId])
  @@index([provider, model])
  @@index([createdAt])
}

// One immutable, versioned snapshot of the engagement's Implementation Roadmap
// (roadmap Phase 7). It mirrors RecommendationVersion narrowly: generation
// creates a new active version, older versions are superseded and readable, and
// consultant edits autosave into the active version behind optimistic
// concurrency. The roadmap references Recommendation identities and copied
// Implementation Pattern reasoning; it never mutates either source.
model ImplementationRoadmapVersion {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        RoadmapVersionStatus @default(active)

  content     Json
  reviewState RoadmapReviewState @default(ai_draft)

  sourceRecommendationVersionId     String
  sourceRecommendationVersion       RecommendationVersion @relation(fields: [sourceRecommendationVersionId], references: [id], onDelete: Cascade)
  sourceRecommendationVersionNumber Int
  sourceRecommendationFingerprint   String

  analysisRunId String?
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  createdByUserId String?
  createdBy       User?    @relation("RoadmapVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lastModifiedAt       DateTime @default(now())
  lastModifiedByUserId String?
  lastModifiedBy       User?    @relation("RoadmapVersionLastModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)

  revision Int @default(0)

  @@unique([engagementId, versionNumber])
  @@index([engagementId, status])
  @@index([workspaceId])
  @@index([sourceRecommendationVersionId])
  @@index([createdAt])
}

model ConsultantReportVersion {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        ReportVersionStatus @default(active)
  reviewState   ReportReviewState   @default(draft)

  content Json

  sourceDiscoveryFingerprint        String
  sourceAssessmentRevision          Int
  sourceAssessmentFingerprint       String
  sourceOpportunityVersionId        String
  sourceOpportunityVersionNumber    Int
  sourceOpportunityFingerprint      String
  sourceRecommendationVersionId     String
  sourceRecommendationVersionNumber Int
  sourceRecommendationFingerprint   String
  sourceRoadmapVersionId            String
  sourceRoadmapVersionNumber        Int
  sourceRoadmapFingerprint          String
  sourceSnapshot                    Json?

  analysisRunId String?
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  createdByUserId String?
  createdBy       User?    @relation("ReportVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lastModifiedAt       DateTime @default(now())
  lastModifiedByUserId String?
  lastModifiedBy       User?    @relation("ReportVersionLastModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)

  revision Int @default(0)

  approvedAt                DateTime?
  approvedByUserId          String?
  approvedBy                User?     @relation("ReportVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedSourceFingerprint String?

  publications DocumentPublication[]
  pdfArtifacts  ReportPdfArtifact[]

  @@unique([engagementId, versionNumber])
  @@index([engagementId, status])
  @@index([workspaceId])
  @@index([sourceOpportunityVersionId])
  @@index([sourceRecommendationVersionId])
  @@index([sourceRoadmapVersionId])
  @@index([createdAt])
}

model DocumentPublication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  reportVersionId String
  reportVersion   ConsultantReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)

  pdfArtifactId String?
  pdfArtifact   ReportPdfArtifact? @relation(fields: [pdfArtifactId], references: [id], onDelete: Restrict)

  status DocumentPublicationStatus @default(active)

  clientUserId String?
  clientUser   User?   @relation("DocumentPublishedForClient", fields: [clientUserId], references: [id], onDelete: SetNull)

  title          String?
  managerMessage String?

  publishedAt       DateTime @default(now())
  publishedByUserId String
  publishedBy       User     @relation("DocumentPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)

  revokedAt       DateTime?
  revokedByUserId String?
  revokedBy       User?     @relation("DocumentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  emailNotificationAttemptedAt DateTime?
  emailNotificationDeliveredAt DateTime?
  emailNotificationFailure     String?

  notificationAttempts DocumentNotificationAttempt[]

  @@index([workspaceId])
  @@index([engagementId])
  @@index([reportVersionId])
  @@index([pdfArtifactId])
  @@index([clientUserId])
  @@index([status])
  @@index([publishedAt])
}

model ReportPdfArtifact {
