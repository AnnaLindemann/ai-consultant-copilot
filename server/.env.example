# Server environment. Copy to `server/.env` and fill in the secrets:
#   cp server/.env.example server/.env

# HTTP port the Express API listens on.
PORT=8787

# PostgreSQL connection string. Must match the credentials/port in the root .env
# used by docker-compose.
DATABASE_URL="postgresql://ai_user:ai_password@localhost:5432/ai_consultant_db"

# LLM provider selection. Supported: groq | openai | anthropic (only groq is
# implemented today; configuring another is refused at startup). Both have
# defaults, so both may be omitted.
#
# NOTE: changing LLM_MODEL stops AI processing until an Administrator approves
# the new provider/model pair — the compliance gate matches the exact pair that
# would actually be called. See docs/operations.md "Changing the AI model".
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Provider request settings. All optional; the defaults are in
# `src/lib/providers/groq.provider.ts` and are stated there rather than
# inherited from the SDK.
#
# LLM_TIMEOUT_MS=120000            # 1000..600000
# LLM_MAX_RETRIES=0                # 0..5. Retries cost money; opt in deliberately.
# LLM_TEMPERATURE=0.2              # unset = provider default
#
# Set in production, and not commented out: leaving it unset inherits the
# provider's own ceiling, which for openai/gpt-oss-120b is 3072 completion
# tokens — and a reasoning model's thinking is billed against that same budget.
# The Assessment stage needs a median 4786 completion tokens, so the inherited
# ceiling truncates it mid-object. The parser refuses to repair a truncated
# response (`parse-llm-json.ts`), so the run is recorded as failed. Measured
# with `npm run benchmark:llm`; re-measure for a different model.
LLM_MAX_COMPLETION_TOKENS=8000     # 1..200000
#
# The next two are unset on purpose. Whether a model supports structured JSON
# output, and what it does with a reasoning model's thinking, are per-model
# facts to establish against the live API — run `npm run benchmark:llm` first.
# Sending a parameter a model rejects fails every call.
#
# LLM_RESPONSE_FORMAT=json_object  # json_object
# LLM_REASONING_FORMAT=hidden      # hidden | parsed | raw

# Provider API key (required for the selected provider). Get one from the
# provider's console — do NOT commit a real key.
GROQ_API_KEY=your-groq-api-key

# Langfuse observability (optional). Tracing is only active when enabled and
# configured; the app degrades gracefully when these are absent.
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# --- Access control (Phase 3A) ---------------------------------------------

# Base URL this API is reachable at. Better Auth builds verification and
# password-reset links against it.
SERVER_BASE_URL=http://localhost:8787

# Origin of the frontend. Used for CORS, for Better Auth's trusted origins, and
# for the links in outgoing email. Comma-separate to name more than one; it is a
# list of EXACT origins and never a pattern, so a preview deployment is trusted
# only by being named on purpose.
CLIENT_ORIGIN=http://localhost:3000

# The parent domain the session cookie is scoped to, for a deployment whose
# frontend and API are on different hosts (app.example.com + api.example.com).
#
# REQUIRED in production whenever those two origins differ, and startup refuses
# without it. A host-only cookie is invisible to the frontend's server
# components and to its proxy, so a login succeeds and every page then bounces
# back to the sign-in screen. Leave it unset locally, where both halves are
# already same-site on localhost. See docs/environment.md.
# AUTH_COOKIE_DOMAIN=.example.com

# Secret Better Auth signs sessions with. REQUIRED in production — the process
# refuses to start without it. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret

# One-time secret for creating the first administrator via POST /auth/bootstrap.
# Bootstrap is refused once any account exists.
AUTH_BOOTSTRAP_SECRET=your-bootstrap-secret

# Email delivery via Resend. REQUIRED in production — without both values the
# process refuses to start rather than silently logging invitation,
# verification, and password-reset mail to the console. Left unset in
# development, mail is not sent and only its metadata (recipient, subject, body
# size) is logged: no message body, link, or token ever reaches a log line.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="AI Consulting Workbench <noreply@example.com>"

# Local development mailbox. Set to 1 to capture outgoing mail as files instead
# of sending it, so verification, password-reset, invitation, and
# Discovery-Access flows are walkable without a mail vendor and without reading
# tokens out of the database. Read the captured messages with:
#
#   npm run mail:dev --prefix server
#
# Off unless explicitly set, refused outright with NODE_ENV=production, bounded
# to the most recent messages, and written to a git-ignored directory.
# EMAIL_DEV_MAILBOX=1
# EMAIL_DEV_MAILBOX_DIR=./tmp/dev-mailbox

# --- Security, privacy and AI compliance (Phase 10) -------------------------

# Encryption at rest for stored documents. When set, rendered report PDFs are
# stored as AES-256-GCM ciphertext and decrypted on read; artifacts written
# before the key existed stay readable as they are. REQUIRED in production if
# the Workspace Compliance Policy asks for encryption at rest — without it, the
# policy asks for something the deployment cannot honour and the bytes are
# stored as rendered. Generate one with:  openssl rand -base64 32
#
# Losing this key makes every artifact encrypted with it unreadable. Rotate it
# deliberately: the key that produced an artifact is identified on the artifact
# row, so a rotation can find what it still has to re-wrap.
DOCUMENT_ENCRYPTION_KEY=your-document-encryption-key

# Secret the expiring signed document-download links are signed with. Falls back
# to BETTER_AUTH_SECRET when unset — both sign short-lived, server-issued
# bearers for one deployment — so set it only when the two should rotate
# independently.
# DOCUMENT_ACCESS_SECRET=your-document-access-secret

# Encryption in transit. With REQUIRE_HTTPS=true the API refuses a request that
# did not arrive over TLS (rather than redirecting it, which would already have
# carried the session cookie over the clear channel) and sends HSTS. Behind a
# TLS-terminating proxy, TRUST_PROXY=true is what makes Express read
# `x-forwarded-proto`; without it a client could claim to be secure by setting
# the header itself. Both are off in development, which is served over HTTP.
# REQUIRE_HTTPS=true
# TRUST_PROXY=true

# Transport security for the database connection is set on DATABASE_URL itself.
# A production deployment appends `?sslmode=require` (or stricter) to it.

# --- Test and migration databases ------------------------------------------

# Where `npm run test:integration --prefix server` builds its throwaway
# database. It is used only as the *server* to create a uniquely-named database
# on; that database is migrated with the real Prisma chain and dropped
# afterwards. Falls back to DATABASE_URL when unset. The integration suite fails
# — it does not skip — when no PostgreSQL is reachable.
# TEST_DATABASE_URL="postgresql://ai_user:ai_password@localhost:5432/postgres"

# Shadow database for Prisma's migration *development* tooling: the scratch
# database that `prisma migrate dev` and `npm run prisma:drift-check` replay
# `prisma/migrations` into from empty, so the replayed result can be compared
# with `prisma/schema.prisma`. Prisma drops and rebuilds its contents on every
# run.
#
# It MUST be a separate, empty, disposable database. Never point it at
# DATABASE_URL or any database holding engagement content — pointing it at the
# application database would destroy that database. `prisma migrate deploy`, the
# command a real environment runs, never uses it.
#
# Use the same credentials and port as DATABASE_URL above, only a different
# database name:
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_consultant_shadow"
